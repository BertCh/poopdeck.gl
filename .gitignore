# Rust
/target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed: this workspace ships binary crates (stt-build, etc.)

# TypeScript / Node
node_modules/
dist/
build/
*.tsbuildinfo
.npm/
.yarn/
.pnp.*
.turbo/

# Compiled TypeScript output (must not live next to .ts sources).
# Patterns are **/-prefixed so they match packages/*/src, not just root src/.
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
!**/src/**/*.config.js
!**/src/**/*.test.js
# Hand-written ambient type shims (not compiler output).
!**/src/vite-env.d.ts
**/test/**/*.js
**/test/**/*.js.map
**/test/**/*.d.ts
**/test/**/*.d.ts.map
**/vitest.config.js
**/vitest.config.js.map
**/vitest.config.d.ts
**/vitest.config.d.ts.map

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test outputs
coverage/
.nyc_output/
*.log
temp_eval/

# Secrets / local env. The root .env holds R2 credentials; .local files hold
# per-machine secrets. Committed, non-secret config (e.g. examples/showcase/
# .env.production with the public R2 URL, and *.example templates) is allowed.
.env
.env.local
.env.*.local
.env.r2
rclone.conf

# Tile files
*.stt
# Exception: the tiny bench fixture is checked in so CI can run regression
# checks without generating data over the network.
!tools/bench/baselines/earthquakes-ci.stt
# Exception: TS contract test fixtures are committed so the test can run
# without the Rust toolchain being available.
!packages/core/test/fixtures/*.stt
*.mbtiles
*.pmtiles
test-data/*.json
test-data/*.geojson

# Build artifacts
*.wasm
pkg/

# Data
data/
raw/
processed/
*.geojson
*.csv
*.parquet
*.tle
*.zip
scripts/data-generation/data/

# Publish-build staging tree (zstd-19 + paged re-transcode of the live packed
# datasets, written by scripts/repack-publish-all.sh before an R2 deploy).
examples/showcase/public/data-publish/
examples/showcase/public/data-v2/

# Raw & processed data formats — never commit datasets; they live on R2 or are
# regenerated by scripts/data-generation. Tracked fixtures are the explicit
# `!`-exceptions above (sample.stt, earthquakes-ci.stt).
*.arrow
*.feather
*.ipc
*.tsv
*.ndjson
*.jsonl
*.fgb
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.tif
*.tiff
*.geotiff
*.nc
*.nc4
*.h5
*.hdf5
*.npy
*.npz
*.las
*.laz
*.gz

# Ad-hoc evaluation / experiment scratch (write analyses elsewhere — docs/)
evaluation/

# Benchmark scratch (DuckDB/PostGIS integration: generated .duckdb / parquet / tiles)
/scratch-*/

# Loose root-level fixtures that occasionally appear during dev
/test*.html
/test*.stt
/rebuild-*.sh

# Python virtualenvs for the data-generation extractors (large; recreated per
# the per-extractor venv convention, never committed).
scripts/data-generation/venv-*/

# OSRM routing data (large binary files)
scripts/data-generation/osrm-data/
*.osm.pbf
*.osrm

# Raw Argoverse 2 sensor logs staged for the AV-cockpit extractor (~1 GB/log;
# re-downloaded from the public s3://argoverse bucket, deleted after each build).
scripts/data-generation/av2-raw/
*.osrm.*

# OSM editing-history inputs for `stt-generate osm-edits` (large; downloaded
# as a prerequisite, never committed). History extracts + the changeset dump.
*.osh.pbf
*.osm.bz2
*.osm.opl
.claude/
.npmrc
