# TypeScript / Node
node_modules/
dist/
build/
# React Router framework mode: generated route types (react-router typegen)
.react-router/
*.tsbuildinfo
.npm/
.yarn/
.pnp.*
.turbo/

# Generated build artifact: the docs corpus bundled into @poopdeck.gl/mcp for
# offline/npx use (written by packages/mcp/scripts/copy-docs.mjs at build time).
/packages/mcp/docs/

# Compiled TypeScript output (must not live next to .ts sources).
# Patterns are **/-prefixed so they match packages/*/src, not just root src/.
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
!**/src/**/*.config.js
!**/src/**/*.test.js
# Hand-written ambient type shims (not compiler output).
!**/src/vite-env.d.ts
**/test/**/*.js
**/test/**/*.js.map
**/test/**/*.d.ts
**/test/**/*.d.ts.map
**/vitest.config.js
**/vitest.config.js.map
**/vitest.config.d.ts
**/vitest.config.d.ts.map

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test outputs
coverage/
.nyc_output/
*.log
# The regen/build log drop. `*.log` above already covers what lands here today,
# but the directory itself is scratch — ignore it whole so a stray .txt/.json
# transcript can't slip into a public commit.
logs/
temp_eval/

# Secrets / local env. `.local` files hold per-machine secrets. Committed,
# non-secret config (e.g. examples/showcase/.env.production with the public R2
# URL, and *.example templates) is allowed.
.env
.env.local
.env.*.local

# Benchmark output — frame-cost.mjs writes a JSON report and a screenshot per
# run. They are per-machine measurements; the numbers worth keeping get written
# up in docs/roadmap/measurements-*.md instead.
tools/bench/out/

# Tile files. Datasets are built by the STT toolchain and served from R2 —
# never committed here.
*.stt
# Exception: the tiny bench fixture is checked in so CI can run regression
# checks without generating data over the network.
!tools/bench/baselines/earthquakes-ci.stt
# Exception: the conformance vectors vendored from the STT repo (see
# .stt-sync.json) are committed so the reader tests run without the Rust
# toolchain being available.
!packages/core/test/fixtures/*.stt
*.mbtiles
*.pmtiles
test-data/*.json
test-data/*.geojson

# Build artifacts
*.wasm
pkg/

# Local dataset trees. The showcase reads from R2 in production; a local
# `public/data` is a developer convenience and is never committed. Since the
# 2026-08-26 split the fleet lives in the STT repo, so `public/data` is usually
# a SYMLINK to `../spatiotemporal-tiles/data-fleet` — and a trailing-slash
# pattern does not match a symlink, hence both forms below.
examples/showcase/public/data
examples/showcase/public/data/
examples/showcase/public/data-publish/
examples/showcase/public/data-v2/
examples/showcase/public/data-v3/
data/
raw/
processed/
*.geojson
*.csv
*.parquet
*.zip
*.arrow
*.feather
*.ipc
*.tsv
*.ndjson
*.jsonl

# Ad-hoc evaluation / experiment scratch (write analyses elsewhere — docs/)
evaluation/

# Loose root-level fixtures that occasionally appear during dev
/test*.html
/test*.stt

.claude/
.npmrc

# Local MCP server config (machine-specific absolute paths)
/.mcp.json

# Local pnpm store created when a store path is set inside the repo; never an
# input to a build, and the real store lives under ~/Library/pnpm.
.pnpm-store/
# Scratch HEAD-state snapshot of a package's src/, used for A/B measurement
# runs (tile-loading audit). Unreferenced by any build or test.
**/.headsrc/

# Generated by scripts/check-doc-snippets.mjs: the doc code samples,
# extracted as compilable files for one `tsc` pass. Removed on success,
# kept on failure so the errors can be read in context.
examples/showcase/.doc-snippets/

# Wrangler local state
.wrangler/
