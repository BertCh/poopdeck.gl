{
  "name": "spatiotemporal-tiles",
  "version": "0.1.0",
  "description": "High-performance spatiotemporal tile format for interactive time series visualization",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "generate-proto": "pnpm run generate-proto:js",
    "generate-proto:js": "pbjs -t static-module -w es6 --es6 -o packages/core/src/proto.js proto/*.proto && pbts -o packages/core/src/proto.d.ts packages/core/src/proto.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "protobufjs-cli": "^1.1.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robertchristie/spatiotemporal-tiles.git"
  },
  "keywords": [
    "tiles",
    "spatiotemporal",
    "geospatial",
    "deck.gl",
    "visualization",
    "time-series",
    "animation"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
