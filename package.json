{
  "name": "poopdeck.gl",
  "version": "0.1.0",
  "description": "Time-aware renderers for SpatioTemporal Tiles: deck.gl, Three.js, MapLibre and Cesium backends, playback, and the poopdeck.gl showcase",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:snippets": "node scripts/check-doc-snippets.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "project:check": "node scripts/check-project-status.mjs",
    "stt:sync": "node scripts/sync-stt.mjs",
    "stt:check": "node scripts/sync-stt.mjs --check",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && pnpm -r --filter='./packages/*' publish --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.9.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BertCh/poopdeck.gl.git"
  },
  "keywords": [
    "deck.gl",
    "three.js",
    "maplibre",
    "cesium",
    "visualization",
    "time-series",
    "animation",
    "spatiotemporal",
    "tiles",
    "geospatial"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
