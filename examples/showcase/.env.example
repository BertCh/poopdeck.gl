# Showcase environment. Copy to `.env.local` (gitignored) and fill in.

# Mapbox access token for basemap surfaces (demo viewer, hover preview, AV
# cockpit). Client-side tokens are public by nature — create a URL-restricted
# token at https://account.mapbox.com/access-tokens/ for deploys.
VITE_MAPBOX_TOKEN=

# Google Maps Platform key for the Photorealistic 3D Tiles backdrop in the
# /drive cockpit (optional; the toggle hides itself without it).
VITE_GOOGLE_MAPS_API_KEY=

# Base URL for tile data when not serving from public/data (e.g. the R2 custom
# domain). Set in .env.production for deploys.
# VITE_DATA_BASE_URL=
