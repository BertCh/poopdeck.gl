{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poopdeck.gl/project-status.schema.json",
  "title": "poopdeck.gl project status contract",
  "description": "What this repository ships and on what toolchain. The `stt` block is NOT authored here: it is vendored from the SpatioTemporal Tiles repository by scripts/sync-stt.mjs and describes the archive contract this renderer reads.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "updated",
    "release",
    "toolchain",
    "packages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "updated": { "type": "string", "format": "date" },
    "release": {
      "type": "object",
      "required": ["javascript"],
      "properties": {
        "javascript": { "$ref": "#/$defs/version" }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": ["node", "nodeMajor", "runtimeNode", "pnpm"],
      "properties": {
        "node": { "type": "string" },
        "nodeMajor": { "type": "integer", "minimum": 1 },
        "runtimeNode": { "type": "string" },
        "pnpm": { "$ref": "#/$defs/version" }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/surface" },
          {
            "type": "object",
            "required": ["version", "published"],
            "properties": {
              "version": { "$ref": "#/$defs/version" },
              "published": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "otherSurfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    },
    "stt": {
      "description": "Vendored from BertCh/spatiotemporal-tiles at the commit pinned in .stt-sync.json. Null only before the first sync.",
      "type": ["object", "null"],
      "properties": {
        "release": {
          "type": "object",
          "required": ["rust"],
          "properties": { "rust": { "$ref": "#/$defs/version" } },
          "additionalProperties": false
        },
        "toolchain": {
          "type": "object",
          "required": ["rust"],
          "properties": {
            "rust": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          },
          "additionalProperties": false
        },
        "archive": {
          "type": "object",
          "required": ["writes", "reads"],
          "properties": {
            "writes": { "$ref": "#/$defs/archiveVersions" },
            "reads": {
              "type": "object",
              "required": ["formatVersions", "directoryVersions"],
              "properties": {
                "formatVersions": { "$ref": "#/$defs/versionList" },
                "directoryVersions": { "$ref": "#/$defs/versionList" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
        "repositoryOnlyCommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "versionList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "archiveVersions": {
      "type": "object",
      "required": ["formatVersion", "directoryVersion"],
      "properties": {
        "formatVersion": { "type": "integer", "minimum": 1 },
        "directoryVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["name", "support"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "support": { "enum": ["stable", "preview", "experimental"] }
      }
    }
  }
}
