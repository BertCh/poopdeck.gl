{
  "name": "@poopdeck.gl/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive showcase for SpatioTemporal Tiles",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit && NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules/.vite dist *.tsbuildinfo && find src -type f \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) ! -name '*.config.js' ! -name '*.test.js' -delete"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/extensions": "9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mesh-layers": "9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@deck.gl/widgets": "9.3.2",
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/layers": "workspace:*",
    "@poopdeck.gl/maplibre": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*",
    "@poopdeck.gl/react": "workspace:*",
    "@poopdeck.gl/three": "workspace:*",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "github-slugger": "^2.0.0",
    "mapbox-gl": "^3.16.0",
    "maplibre-gl": "^3.6.0",
    "mermaid": "^11.15.0",
    "postcss": "^8.5.6",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^7.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "three": "^0.184.0",
    "@poopdeck.gl/cesium": "workspace:*",
    "cesium": "^1.142.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
