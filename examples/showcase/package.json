{
  "name": "@poopdeck.gl/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive showcase for SpatioTemporal Tiles",
  "scripts": {
    "dev": "react-router dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 react-router typegen && NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit && NODE_OPTIONS=--max-old-space-size=6144 react-router build && node scripts/check-bundle-size.mjs",
    "perf:budget": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview --outDir build/client",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "clean": "rm -rf node_modules/.vite build .react-router *.tsbuildinfo && find src -type f \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) ! -name '*.config.js' ! -name '*.test.js' -delete"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.3.10",
    "@deck.gl/core": "9.3.10",
    "@deck.gl/extensions": "9.3.10",
    "@deck.gl/geo-layers": "9.3.10",
    "@deck.gl/layers": "9.3.10",
    "@deck.gl/mapbox": "9.3.10",
    "@deck.gl/mesh-layers": "9.3.10",
    "@deck.gl/react": "9.3.10",
    "@deck.gl/widgets": "9.3.10",
    "@poopdeck.gl/cesium": "workspace:*",
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/layers": "workspace:*",
    "@poopdeck.gl/maplibre": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*",
    "@poopdeck.gl/react": "workspace:*",
    "@poopdeck.gl/three": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "cesium": "^1.144.0",
    "github-slugger": "^2.0.0",
    "h3-js": "^4.5.0",
    "mapbox-gl": "^3.29.0",
    "maplibre-gl": "^6.6.0",
    "mermaid": "^11.17.1",
    "postcss": "^8.5.26",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
