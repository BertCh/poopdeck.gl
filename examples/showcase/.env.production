# Production build: serve .stt tile archives from Cloudflare R2 instead of
# bundling ~16GB into the deploy. datasets.ts rewrites every /data/*.stt path
# to <VITE_DATA_BASE_URL>/data/*.stt. Public, non-secret — safe to commit.
#
# To use a custom domain later, swap this for e.g. https://tiles.yourdomain.com
VITE_DATA_BASE_URL=https://pub-9bfdd9f4981d44b1acb3624ba7bded45.r2.dev
