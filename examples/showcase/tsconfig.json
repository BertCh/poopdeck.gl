{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // React Router framework mode generates per-route types under
    // .react-router/types (via `react-router typegen`); rootDirs makes the
    // virtual `./+types/*` modules resolve alongside the source.
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src", ".react-router/types/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
