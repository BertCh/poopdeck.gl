{
  "name": "@poopdeck.gl/render-test",
  "version": "0.1.0",
  "description": "Automated browser rendering + FPS regression test for the @poopdeck.gl/layers showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "probe": "node probe-all-demos.mjs",
    "probe:scale": "node probe-scale-sweep.mjs",
    "sweep": "playwright test tests/sweep.spec.ts",
    "sweep:update": "STT_BLESS_BASELINES=1 playwright test tests/sweep.spec.ts",
    "install-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
