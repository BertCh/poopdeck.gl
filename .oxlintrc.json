{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "unicorn/no-new-array": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/expect-expect": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/.react-router/**",
    "**/coverage/**",
    "**/*.d.ts",
    "**/src/**/*.js",
    "**/src/**/*.js.map",
    "target/**",
    "data/**",
    "packages/mcp/docs/**",
    "examples/showcase/public/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**",
        "**/__tests__/**"
      ],
      "env": {
        "vitest": true
      }
    }
  ]
}
