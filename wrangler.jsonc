{
  // Root-level wrangler config so ANY `wrangler` command run from the repo root
  // resolves a config WITHOUT needing `--config` — notably Cloudflare's
  // non-production "Non-production branch deploy command" (`npx wrangler versions
  // upload`), which otherwise fails with "Missing entry-point to Worker script
  // or to assets directory" because there was no config at the root.
  //
  // Same worker name + same built assets as examples/showcase/wrangler.jsonc.
  // The production deploy command may still pass
  // `--config examples/showcase/wrangler.jsonc` (an explicit --config wins);
  // both point at the same worker + same dist, so they're interchangeable.
  // Keep the two in sync (name, assets target, not_found_handling).
  //
  // NOTE: "directory" is relative to THIS file (repo root) → the showcase build
  // output at examples/showcase/dist (produced by
  // `turbo run build --filter=@poopdeck.gl/showcase`).
  "name": "spatiotemporal-tiles",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./examples/showcase/dist",
    "not_found_handling": "single-page-application"
  }
}
