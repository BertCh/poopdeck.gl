diff --git a/src/portable/uniform-block.ts b/src/portable/uniform-block.ts
index fe45c7d6d300da136d066bc1db7e7f0cbe3b6e71..43759bc87566a1bc3d516fc3fc75c5be7a0c2331 100644
--- a/src/portable/uniform-block.ts
