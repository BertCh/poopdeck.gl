+      // call). `_setUniform` already early-returns on an equal value and sets
+      // `modifiedUniforms[key]` only on a real change, and getAllUniforms()
+      // clears that map on each write — so it is exactly "changed since the
+      // last upload". See docs/roadmap/measurements-2026-08.md.
+      if (this.modifiedUniforms[key] && !this.needsRedraw) {
         this.setNeedsRedraw(`${this.name}.${key}=${value}`);
       }
     }
