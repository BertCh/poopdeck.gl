# Cloudflare R2 credentials for hosting .stt tile archives.
# Copy to `.env` at the repo root (gitignored) and fill in — scripts/r2-sync.sh
# reads `.env`. Never commit the real file.
#
# Create the token: Cloudflare dashboard -> R2 -> Manage API Tokens ->
# Create API Token -> permission "Object Read & Write".

# Account ID (R2 overview page, or in the S3 endpoint hostname).
R2_ACCOUNT_ID=

# Token credentials shown once on creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket that holds the tiles.
R2_BUCKET=stt-tiles

# Public custom domain you attach to the bucket (no trailing slash), e.g.
# https://tiles.example.com  — used as VITE_DATA_BASE_URL for the showcase.
R2_PUBLIC_BASE_URL=
