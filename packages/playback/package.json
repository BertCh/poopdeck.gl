{
  "name": "@poopdeck.gl/playback",
  "version": "0.1.0",
  "description": "Framework- and renderer-agnostic playback engine (clock, buffering governor, media-element facade) for time-series and spatiotemporal visualization",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "playback",
    "timeline",
    "time-series",
    "animation",
    "spatiotemporal",
    "buffering"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
