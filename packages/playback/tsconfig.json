{
  "extends": "../../tsconfig.pkg.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // TypeScript 7 does not auto-include pnpm's symlinked
    // `node_modules/@types` the way 5.x did — and `derive-params` reads process.env.
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
