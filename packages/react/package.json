{
  "name": "@poopdeck.gl/react",
  "version": "0.5.0",
  "description": "React hooks and UI components for spatiotemporal/time-series playback — usePlayback, keyboard controls, a transport bar + scrubber + density strip, and a scrubber hover-preview",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hover-preview": {
      "types": "./dist/hover-preview.d.ts",
      "default": "./dist/hover-preview.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*"
  },
  "peerDependencies": {
    "@deck.gl/core": ">=9.3.0 <10.0.0",
    "@deck.gl/react": ">=9.3.0 <10.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@deck.gl/core": {
      "optional": true
    },
    "@deck.gl/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "react",
    "playback",
    "scrubber",
    "timeline",
    "time-series",
    "spatiotemporal",
    "deck.gl"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
