{
  "name": "@poopdeck.gl/three",
  "version": "0.5.0",
  "description": "Three.js + TSL (Three Shading Language / WebGPU) renderer for SpatioTemporal Tiles — an independent, GPU-native alternative to the deck.gl renderer, with optional react-three-fiber bindings. First-class AV LIDAR cockpit (oriented Gaussian surfels in a local metric frame).",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./r3f": {
      "types": "./dist/r3f/index.d.ts",
      "default": "./dist/r3f/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.4.28",
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "earcut": "^3.0.0",
    "h3-js": "^4.1.0"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19",
    "three": ">=0.183.0"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.6.0",
    "@types/earcut": "^2.1.4",
    "@types/react": "^19.2.0",
    "@types/three": "^0.184.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.184.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/three#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "tsl",
    "webgpu",
    "react-three-fiber",
    "spatiotemporal",
    "lidar",
    "point-cloud",
    "surfel",
    "visualization"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
