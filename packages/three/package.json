{
  "name": "@poopdeck.gl/three",
  "version": "0.1.0",
  "description": "Three.js + TSL (Three Shading Language / WebGPU) renderer for SpatioTemporal Tiles — an independent, GPU-native alternative to the deck.gl renderer, with optional react-three-fiber bindings. First-class AV LIDAR cockpit (oriented Gaussian surfels in a local metric frame).",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./r3f": {
      "types": "./dist/r3f/index.d.ts",
      "import": "./dist/r3f/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*",
    "earcut": "^3.0.0"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9.0.0",
    "@react-three/fiber": ">=8.15.0",
    "react": ">=18",
    "three": ">=0.168.0"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@types/earcut": "^2.1.4",
    "@types/react": "^18.2.0",
    "@types/three": "^0.171.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.171.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "three",
    "threejs",
    "tsl",
    "webgpu",
    "react-three-fiber",
    "spatiotemporal",
    "lidar",
    "point-cloud",
    "surfel",
    "visualization"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
