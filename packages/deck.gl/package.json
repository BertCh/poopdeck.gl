{
  "name": "@stt/deck.gl",
  "version": "0.1.0",
  "description": "deck.gl layers for spatiotemporal tiles",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typetest.json",
    "lint": "eslint src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@stt/core": "workspace:*",
    "h3-js": "^4.1.0"
  },
  "peerDependencies": {
    "@deck.gl/aggregation-layers": ">=9.3.0 <10.0.0",
    "@deck.gl/core": ">=9.3.0 <10.0.0",
    "@deck.gl/extensions": ">=9.3.0 <10.0.0",
    "@deck.gl/geo-layers": ">=9.3.0 <10.0.0",
    "@deck.gl/layers": ">=9.3.0 <10.0.0",
    "@luma.gl/core": ">=9.3.0 <10.0.0",
    "@luma.gl/engine": ">=9.3.0 <10.0.0"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/extensions": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@luma.gl/core": "^9.3.0",
    "@luma.gl/engine": "^9.3.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "deck.gl",
    "tiles",
    "spatiotemporal",
    "visualization"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
