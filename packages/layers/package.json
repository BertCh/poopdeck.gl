{
  "name": "@poopdeck.gl/layers",
  "version": "0.7.0",
  "description": "deck.gl layers for spatiotemporal tiles",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typetest.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@poopdeck.gl/core": "workspace:*",
    "@poopdeck.gl/playback": "workspace:*",
    "h3-js": "^4.5.0"
  },
  "peerDependencies": {
    "@deck.gl/aggregation-layers": ">=9.3.0 <10.0.0",
    "@deck.gl/core": ">=9.3.0 <10.0.0",
    "@deck.gl/extensions": ">=9.3.0 <10.0.0",
    "@deck.gl/geo-layers": ">=9.3.0 <10.0.0",
    "@deck.gl/layers": ">=9.3.0 <10.0.0",
    "@deck.gl/mesh-layers": ">=9.3.0 <10.0.0",
    "@luma.gl/core": ">=9.3.0 <10.0.0",
    "@luma.gl/engine": ">=9.3.0 <10.0.0"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "9.3.10",
    "@deck.gl/core": "9.3.10",
    "@deck.gl/extensions": "9.3.10",
    "@deck.gl/geo-layers": "9.3.10",
    "@deck.gl/layers": "9.3.10",
    "@deck.gl/mesh-layers": "9.3.10",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@types/node": "^24.9.2",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/layers"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/layers#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "deck.gl",
    "tiles",
    "spatiotemporal",
    "visualization"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
