{
  "name": "@poopdeck.gl/cesium",
  "version": "0.5.0",
  "description": "EXPERIMENTAL, not published — CesiumJS backend for spatiotemporal tiles; renders STT on a real WGS84 globe",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "cesium": "^1"
  },
  "dependencies": {
    "@poopdeck.gl/core": "workspace:*"
  },
  "devDependencies": {
    "cesium": "^1.144.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/cesium"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/cesium#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "cesium",
    "spatiotemporal",
    "geospatial",
    "globe"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
