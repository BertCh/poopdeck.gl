{
  "name": "@poopdeck.gl/core",
  "version": "0.3.0",
  "description": "Core TypeScript library for reading spatiotemporal tiles",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./time-filter": {
      "types": "./dist/render/time-filter.d.ts",
      "default": "./dist/render/time-filter.js"
    },
    "./style": {
      "types": "./dist/render/style.d.ts",
      "default": "./dist/render/style.js"
    },
    "./geometry": {
      "types": "./dist/render/geometry.d.ts",
      "default": "./dist/render/geometry.js"
    },
    "./trips": {
      "types": "./dist/render/trips.d.ts",
      "default": "./dist/render/trips.js"
    },
    "./shader-codegen": {
      "types": "./dist/render/shader-codegen.d.ts",
      "default": "./dist/render/shader-codegen.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "default": "./dist/geo/index.js"
    },
    "./picking": {
      "types": "./dist/render/picking.d.ts",
      "default": "./dist/render/picking.js"
    },
    "./tileset-adapter": {
      "types": "./dist/render/tileset-adapter.d.ts",
      "default": "./dist/render/tileset-adapter.js"
    },
    "./capabilities": {
      "types": "./dist/render/capabilities.d.ts",
      "default": "./dist/render/capabilities.js"
    },
    "./capabilities-doc": {
      "types": "./dist/render/capabilities-doc.d.ts",
      "default": "./dist/render/capabilities-doc.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && pnpm run build:worker",
    "build:worker": "esbuild src/tile-decoder.worker.ts --bundle --format=esm --platform=browser --target=esnext --sourcemap --outfile=dist/tile-decoder.worker.js",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "apache-arrow": "^17.0.0",
    "earcut": "^3.0.0",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "tiles",
    "spatiotemporal",
    "geospatial"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
