{
  "name": "@stt/core",
  "version": "0.1.0",
  "description": "Core TypeScript library for reading spatiotemporal tiles",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && pnpm run build:worker",
    "build:worker": "esbuild src/tile-decoder.worker.ts --bundle --format=esm --platform=browser --target=esnext --outfile=dist/tile-decoder.worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "apache-arrow": "^17.0.0",
    "fflate": "^0.7.4",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "earcut": "^3.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "tiles",
    "spatiotemporal",
    "geospatial"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
