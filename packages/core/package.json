{
  "name": "@stt/core",
  "version": "0.1.0",
  "description": "Core TypeScript library for reading spatiotemporal tiles",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "apache-arrow": "^17.0.0",
    "fzstd": "^0.1.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "tiles",
    "spatiotemporal",
    "geospatial"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
