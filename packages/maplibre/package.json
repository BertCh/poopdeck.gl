{
  "name": "@poopdeck.gl/maplibre",
  "version": "0.6.0",
  "description": "MapLibre GL custom-layer adapter for SpatioTemporal Tiles archives",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@poopdeck.gl/core": "workspace:*"
  },
  "peerDependencies": {
    "h3-js": "^4.1.0",
    "maplibre-gl": "^3 || ^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "h3-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "maplibre-gl": "^6.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BertCh/spatiotemporal-tiles.git",
    "directory": "packages/maplibre"
  },
  "homepage": "https://github.com/BertCh/spatiotemporal-tiles/tree/main/packages/maplibre#readme",
  "bugs": {
    "url": "https://github.com/BertCh/spatiotemporal-tiles/issues"
  },
  "keywords": [
    "stt",
    "spatiotemporal",
    "maplibre",
    "geospatial"
  ],
  "author": "Robert Christie",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
